/* ============================================================
   PHY104 Optical Assistant — Compact Responsive QSS
   Optimized for 1280×800 and 1920×1080. Zero text clipping.
   Tokens replaced at runtime by ThemeManager.
   ============================================================ */

/* ---------- Application Root ---------- */
QMainWindow, QWidget#pageArea, QWidget {
    background: @bg@;
    color: @text@;
    font-family: 'Inter', 'Noto Sans Arabic', 'DejaVu Sans', 'Segoe UI', 'Arial';
    font-size: 12px;
    selection-background-color: @accentPrimary@;
    selection-color: @bg@;
}

QToolTip {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11px;
}

/* ---------- Sidebar ---------- */
QFrame#sidebar {
    background: @surface@;
    border-right: 1px solid @border@;
}

QWidget#sidebarBrand,
QWidget#navigationContents,
QWidget#navigationItems,
QWidget#navigationViewport,
QScrollArea#navigationScroll {
    background: @surface@;
}

QFrame#sidebar QLabel {
    background: transparent;
}

QLabel#brandName {
    color: @accentAmber@;
    font-family: 'JetBrains Mono';
    font-size: 20px;
    font-weight: 700;
}

QLabel#brandProduct {
    color: @text@;
    font-size: 12px;
    font-weight: 700;
}

QLabel#brandMeta, QLabel#sidebarMeta {
    color: @dim@;
    font-family: 'JetBrains Mono';
    font-size: 8px;
}

QLabel#sidebarCount {
    color: @accentAmber@;
    font-family: 'JetBrains Mono';
    font-size: 12px;
    font-weight: 700;
}

QWidget#sidebarFooter {
    background: @surface@;
    border-top: 1px solid @border@;
}

QLabel#engineReady {
    color: @lime@;
    font-family: 'JetBrains Mono';
    font-size: 8px;
}

QPushButton#navItem {
    text-align: left;
    padding: 6px 12px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    background: transparent;
    color: @muted@;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
}

QPushButton#navItem:hover {
    background: @surfaceHover@;
    color: @text@;
    border-left: 3px solid @accentPrimary@;
}

QPushButton#navItem:checked {
    background: @accentPrimaryTint@;
    border-left: 3px solid @accentPrimary@;
    color: @accentPrimary@;
    font-weight: 600;
}

QLabel#navSection {
    font-family: 'JetBrains Mono';
    font-size: 9px;
    color: @dim@;
    padding: 8px 12px 2px 12px;
}

/* ---------- Page Header ---------- */
QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: @text@;
    padding-bottom: 4px;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: @muted@;
    padding-bottom: 12px;
}

QLabel#sectionTitle {
    font-size: 12px;
    font-weight: 700;
    color: @accentAmber@;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding-top: 10px;
    padding-bottom: 6px;
}

QLabel#muted { color: @muted@; }
QLabel#caption {
    font-family: 'JetBrains Mono';
    font-size: 9px;
    color: @dim@;
}
QLabel#colourSwatch {
    border: 1px solid @border@;
    border-radius: 4px;
    min-height: 28px;
}

/* ---------- Panels / Cards (compact) ---------- */
QFrame#panel {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 8px;
}

QFrame#panel[hover="true"] {
    border-color: @accentPrimary@;
    background: @surfaceHover@;
}

QLabel#panelTitle {
    font-size: 13px;
    font-weight: 700;
    color: @text@;
}

QLabel#panelMeta {
    font-family: 'JetBrains Mono';
    font-size: 10px;
    color: @dim@;
}

/* ---------- Field Labels & Inputs (compact) ---------- */
QLabel#fieldLabel {
    font-size: 11px;
    font-weight: 700;
    color: @muted@;
    padding-bottom: 4px;
}

QLabel#hint {
    font-size: 10px;
    color: @dim@;
}

QLineEdit {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: 'JetBrains Mono';
    font-size: 12px;
    min-height: 32px;
}

QLineEdit:focus {
    border: 2px solid @accentPrimary@;
    background: @surfaceHover@;
    padding: 5px 9px;
}

QLineEdit[error="true"] {
    border: 2px solid @error@;
}

QLineEdit[error="true"]:focus {
    border: 2px solid @error@;
    padding: 5px 9px;
}

QLabel#unit {
    font-family: 'JetBrains Mono';
    font-size: 11px;
    color: @dim@;
    padding: 0 6px;
    background: transparent;
    border: none;
}

QLabel#fieldError {
    color: @error@;
    font-size: 10px;
    font-weight: 600;
    padding-top: 3px;
}

/* ---------- ComboBoxes (compact) ---------- */
QComboBox {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 32px;
    min-width: 130px;
    font-family: 'JetBrains Mono';
    font-size: 12px;
    selection-background-color: @accentPrimary@;
    selection-color: @bg@;
}

QComboBox:focus {
    border: 2px solid @accentPrimary@;
    background: @surfaceHover@;
    padding: 5px 9px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @accentPrimary@;
    selection-color: @bg@;
    outline: 0;
    padding: 5px;
    min-width: 130px;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 5px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:selected {
    background: @accentPrimary@;
    color: @bg@;
}

/* ---------- Compact scientific calculator ---------- */
QWidget#calculatorKeypad {
    background: transparent;
}

QLineEdit#lcdInput {
    background: @bg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 32px;
    font-family: 'JetBrains Mono';
    font-size: 14px;
}

QLineEdit#lcdInput:focus {
    border: 1px solid @accentPrimary@;
}

QLabel#lcdResult {
    background: transparent;
    color: @accentAmber@;
    font-family: 'JetBrains Mono';
    font-size: 28px;
    font-weight: 700;
}

QPushButton#calcMode {
    background: @surfaceHover@;
    color: @accentAmber@;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 2px 10px;
    min-height: 26px;
    max-height: 30px;
    font-family: 'JetBrains Mono';
    font-size: 10px;
    font-weight: 700;
}

QPushButton#calcMode:checked {
    background: @accentAmberTint@;
    border-color: @accentAmber@;
}

QPushButton#calcCopy {
    background: transparent;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 0;
    min-height: 28px;
    max-height: 28px;
    min-width: 28px;
    max-width: 28px;
}

QPushButton#calcScientific,
QPushButton#calcNumber,
QPushButton#calcOperator,
QPushButton#calcAction,
QPushButton#calcEquals {
    border-radius: 5px;
    padding: 1px 4px;
    min-height: 30px;
    max-height: 36px;
    font-size: 11px;
}

QPushButton#calcScientific {
    background: @surface@;
    color: @muted@;
    font-weight: 500;
}

QPushButton#calcNumber {
    background: @surfaceHover@;
    color: @text@;
    font-family: 'JetBrains Mono';
    font-size: 12px;
}

QPushButton#calcOperator {
    background: @surface@;
    color: @accentAmber@;
    font-size: 13px;
}

QPushButton#calcAction {
    background: @bg@;
    color: @error@;
    font-size: 10px;
}

QPushButton#calcEquals {
    background: @accentPrimary@;
    color: @bg@;
    border-color: @accentPrimary@;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#calcScientific:hover,
QPushButton#calcNumber:hover,
QPushButton#calcOperator:hover,
QPushButton#calcAction:hover {
    background: @surfaceHover@;
    border-color: @accentPrimary@;
}

QPushButton#calcEquals:hover {
    background: @accentPrimaryHover@;
}

QListWidget#calcHistory {
    background: @bg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget#calcHistory::item {
    padding: 6px 7px;
    border-bottom: 1px solid @border@;
    border-radius: 4px;
}

QListWidget#calcHistory::item:selected {
    background: @accentPrimaryTint@;
    color: @text@;
}

QLabel#calcHint,
QLabel#calcHistoryEmpty {
    color: @dim@;
    font-size: 10px;
}

QLabel#statusError {
    color: @error@;
    background: @errorBg@;
    border: 1px solid @error@;
    border-radius: 5px;
    padding: 5px 8px;
    font-size: 10px;
}

QPushButton#calcHistoryClear {
    background: transparent;
    color: @muted@;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 2px 8px;
    min-height: 28px;
    max-height: 30px;
    font-size: 10px;
}

QPushButton#calcHistoryClear:hover {
    color: @accentAmber@;
    border-color: @accentAmber@;
    background: @accentAmberTint@;
}

/* ---------- Buttons (compact, no clipping) ---------- */
QPushButton {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 34px;
}

QPushButton:hover {
    background: @surfaceHover@;
    border-color: @accentPrimary@;
}

QPushButton:pressed {
    background: @border@;
}

QPushButton:disabled {
    color: @dim@;
    background: @bg@;
    border-color: @bg@;
}

QPushButton#primary {
    background: @accentPrimary@;
    color: @bg@;
    border: none;
    font-weight: 700;
    font-size: 12px;
    min-height: 40px;
    padding: 0 16px;
}

QPushButton#primary:hover {
    background: @accentPrimaryHover@;
}

QPushButton#primary:pressed {
    background: @accentPrimaryPressed@;
}

QPushButton#secondary {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    font-weight: 600;
    font-size: 12px;
    min-height: 34px;
    padding: 0 14px;
}

QPushButton#secondary:hover {
    border-color: @accentPrimary@;
    background: @surfaceHover@;
}

QPushButton#outlineAmber, QPushButton#sendToNotes {
    background: transparent;
    color: @accentAmber@;
    border: 1px solid @accentAmber@;
    border-radius: 6px;
    font-weight: 600;
    font-size: 12px;
    min-height: 34px;
    padding: 0 14px;
}

QPushButton#outlineAmber:hover, QPushButton#sendToNotes:hover {
    background: @accentAmberTint@;
}

QPushButton#presetBtn {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    min-height: 32px;
    text-align: center;
}

QPushButton#presetBtn:hover {
    border-color: @accentAmber@;
    background: @surfaceHover@;
}

QPushButton#presetBtn:pressed {
    background: @bg@;
}

/* ---------- Mode Tabs (compact) ---------- */
QPushButton#modeTab {
    background: @surfaceHover@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    min-height: 30px;
    min-width: 70px;
    font-size: 11px;
    font-weight: 500;
    padding: 0 10px;
}

QPushButton#modeTab:hover {
    border-color: @accentPrimary@;
    color: @accentPrimary@;
}

QPushButton#modeTab:checked {
    background: @accentPrimary@;
    color: @bg@;
    border: none;
    font-weight: 600;
}

/* ---------- Checkboxes ---------- */
QCheckBox {
    color: @text@;
    spacing: 8px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid @border@;
    border-radius: 4px;
    background: @surface@;
}

QCheckBox::indicator:checked {
    background: @accentPrimary@;
    border-color: @accentPrimary@;
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:hover {
    border-color: @accentPrimary@;
}

/* ---------- Sliders (compact) ---------- */
QSlider::groove:horizontal {
    height: 6px;
    background: @border@;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: @accentPrimary@;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: @accentPrimary@;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
    border: 2px solid @bg@;
}

/* ---------- Calculation Register / LCD (compact) ---------- */
QFrame#register {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
}

QLabel#regBig {
    font-family: 'JetBrains Mono';
    font-size: 18px;
    font-weight: 700;
    color: @accentAmber@;
    padding-top: 2px;
    padding-bottom: 2px;
}

QLabel#regLine {
    font-family: 'JetBrains Mono';
    font-size: 11px;
    color: @muted@;
    line-height: 1.6;
    padding-bottom: 1px;
}

QLabel#regCaption {
    font-family: 'JetBrains Mono';
    font-size: 9px;
    color: @dim@;
}

QLabel#regFoot {
    font-family: 'JetBrains Mono';
    font-size: 9px;
    color: @dim@;
}

/* ---------- Notices (compact) ---------- */
QFrame#notice {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 8px 12px;
}

QFrame#notice[error="true"] {
    background: @errorBg@;
    border: 1px solid @error@;
}

QLabel#noticeTitle {
    font-size: 12px;
    font-weight: 700;
    color: @accentAmber@;
}

QFrame#notice[error="true"] QLabel#noticeTitle {
    color: @error@;
}

QLabel#noticeBody {
    font-size: 11px;
    color: @muted@;
    line-height: 1.4;
}

/* ---------- Scrollbars (compact) ---------- */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @dim@;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: @muted@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: @dim@;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: @muted@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Status Bar ---------- */
QStatusBar {
    background: @surface@;
    color: @dim@;
    border-top: 1px solid @border@;
    font-size: 11px;
}

/* ---------- Dashboard card grid ---------- */
QFrame#cardHot {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
}

QFrame#cardHot:hover {
    border-color: @accentPrimary@;
    background: @surfaceHover@;
}

QLabel#cardKicker {
    font-size: 9px;
    font-weight: 600;
    color: @accentAmber@;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding-bottom: 2px;
}

QLabel#cardTitle {
    font-size: 14px;
    font-weight: 700;
    color: @text@;
    padding-bottom: 4px;
}

QLabel#cardText {
    font-size: 11px;
    color: @muted@;
    line-height: 1.4;
    padding-bottom: 6px;
}

QLabel#cardResult {
    font-family: 'JetBrains Mono';
    font-size: 11px;
    font-weight: 700;
    color: @accentAmber@;
    padding-top: 2px;
}

/* ---------- RTL Support Hook ---------- */
/* Arabic: app->setLayoutDirection(Qt::RightToLeft) */
/* Numeric inputs & formulas force LTR via C++: widget->setLayoutDirection(Qt::LeftToRight) */

/* ---------- Guided Refraction lab ---------- */
QDialog#guidedLabDialog { background: @bg@; }
QLabel#guidedLabIntro { color: @muted@; font-size: 12px; }
QLabel#guidedLabProgress {
    color: @accentAmber@;
    font-family: 'JetBrains Mono';
    font-size: 10px;
    font-weight: 700;
    padding: 3px 2px;
}
QWidget#guidedLabStep {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 9px;
}
QLabel#guidedLabHeading { color: @text@; font-size: 16px; font-weight: 700; }
QLabel#guidedLabDetail { color: @muted@; font-size: 12px; line-height: 1.5; }
QLabel#guidedLabFormula {
    color: @accentAmberHover@;
    background: @bg@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 12px;
    font-family: 'JetBrains Mono';
    font-size: 17px;
    font-weight: 700;
}
QLabel#guidedLabResult {
    color: @lime@;
    background: @bg@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 10px;
    font-family: 'JetBrains Mono';
    font-size: 13px;
    font-weight: 600;
}
QPlainTextEdit#guidedLabPrediction, QPlainTextEdit#guidedLabReflection {
    color: @text@;
    background: @bg@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: @accentPrimary@;
}
QPlainTextEdit#guidedLabPrediction:focus, QPlainTextEdit#guidedLabReflection:focus { border-color: @accentAmber@; }
QLabel#guidedLabSavedStatus { color: @lime@; font-size: 11px; }
QPushButton#guidedLabLaunch {
    color: @accentAmber@;
    background: @accentPrimaryTint@;
    border: 1px solid @accentPrimary@;
    min-height: 36px;
}
QPushButton#guidedLabLaunch:hover { background: @surfaceHover@; }

