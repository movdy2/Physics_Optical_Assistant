/* ============================================================
   PHY104 Optical Assistant — Compact Responsive QSS
   Optimized for 1280×800 and 1920×1080. Zero text clipping.
   Tokens replaced at runtime by ThemeManager.
   ============================================================ */

/* ---------- Application Root ---------- */
QMainWindow, QWidget#pageArea, QWidget {
    background: @bg@;
    color: @text@;
    font-family: 'Inter', 'Noto Sans Arabic', 'DejaVu Sans', 'Segoe UI', 'Arial';
    font-size: 12px;
    selection-background-color: @accentCyan@;
    selection-color: @bg@;
}

QToolTip {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11px;
}

/* ---------- Sidebar ---------- */
QFrame#sidebar {
    background: @surface@;
    border-right: 1px solid @border@;
}

QPushButton#navItem {
    text-align: left;
    padding: 6px 12px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    background: transparent;
    color: @muted@;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
}

QPushButton#navItem:hover {
    background: @surfaceHover@;
    color: @text@;
    border-left: 3px solid @accentCyan@;
}

QPushButton#navItem:checked {
    background: rgba(56, 189, 248, 12);
    border-left: 3px solid @accentCyan@;
    color: @accentCyan@;
    font-weight: 600;
}

QLabel#navSection {
    font-family: 'JetBrains Mono';
    font-size: 9px;
    color: @dim@;
    padding: 8px 12px 2px 12px;
}

/* ---------- Page Header ---------- */
QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: @text@;
    padding-bottom: 4px;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: @muted@;
    padding-bottom: 12px;
}

QLabel#sectionTitle {
    font-size: 12px;
    font-weight: 700;
    color: @accentAmber@;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding-top: 10px;
    padding-bottom: 6px;
}

QLabel#muted { color: @muted@; }
QLabel#caption {
    font-family: 'JetBrains Mono';
    font-size: 9px;
    color: @dim@;
}
QLabel#colourSwatch {
    border: 1px solid @border@;
    border-radius: 4px;
    min-height: 28px;
}

/* ---------- Panels / Cards (compact) ---------- */
QFrame#panel {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 8px;
}

QFrame#panel[hover="true"] {
    border-color: @accentCyan@;
    background: @surfaceHover@;
}

QLabel#panelTitle {
    font-size: 13px;
    font-weight: 700;
    color: @text@;
}

QLabel#panelMeta {
    font-family: 'JetBrains Mono';
    font-size: 10px;
    color: @dim@;
}

/* ---------- Field Labels & Inputs (compact) ---------- */
QLabel#fieldLabel {
    font-size: 11px;
    font-weight: 700;
    color: @muted@;
    padding-bottom: 3px;
}

QLabel#hint {
    font-size: 10px;
    color: @dim@;
}

QLineEdit {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: 'JetBrains Mono';
    font-size: 12px;
    min-height: 32px;
}

QLineEdit:focus {
    border: 2px solid @accentCyan@;
    background: @surfaceHover@;
    padding: 5px 9px;
}

QLineEdit[error="true"] {
    border: 2px solid @error@;
}

QLineEdit[error="true"]:focus {
    border: 2px solid @error@;
    padding: 5px 9px;
}

QLabel#unit {
    font-family: 'JetBrains Mono';
    font-size: 11px;
    color: @dim@;
    padding: 0 6px;
    background: transparent;
    border: none;
}

QLabel#fieldError {
    color: @error@;
    font-size: 10px;
    font-weight: 600;
    padding-top: 3px;
}

/* ---------- ComboBoxes (compact) ---------- */
QComboBox {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 32px;
    min-width: 130px;
    font-family: 'JetBrains Mono';
    font-size: 12px;
    selection-background-color: @accentCyan@;
    selection-color: @bg@;
}

QComboBox:focus {
    border: 2px solid @accentCyan@;
    background: @surfaceHover@;
    padding: 5px 9px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @accentCyan@;
    selection-color: @bg@;
    outline: 0;
    padding: 5px;
    min-width: 130px;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 5px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:selected {
    background: @accentCyan@;
    color: @bg@;
}

/* ---------- Buttons (compact, no clipping) ---------- */
QPushButton {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 34px;
}

QPushButton:hover {
    background: @surfaceHover@;
    border-color: @accentCyan@;
}

QPushButton:pressed {
    background: @border@;
}

QPushButton:disabled {
    color: @dim@;
    background: @bg@;
    border-color: @bg@;
}

QPushButton#primary {
    background: @accentCyan@;
    color: @bg@;
    border: none;
    font-weight: 700;
    font-size: 13px;
    min-height: 38px;
    padding: 0 16px;
}

QPushButton#primary:hover {
    background: #2FA3D8;
}

QPushButton#primary:pressed {
    background: #0E7490;
}

QPushButton#secondary {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    font-weight: 600;
    
